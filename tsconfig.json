{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": false,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "types.ts",
    "typings/**/*.d.ts",
    "ingestion/**/*.ts",
    "es/**/*.ts",
    "search/**/*.ts",
    "relevance/**/*.ts",
    "api/**/*.ts",
    "cli/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "data"]
}
